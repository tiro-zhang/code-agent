name=claude-demo
protocol=anthropic
model=claude-sonnet-4-6
base_url=https://api.anthropic.com
api_key=YOUR_ANTHROPIC_API_KEY
thinking=true
max_iterations=20

# 必填：按服务实际总窗口调整；128000 仅为示例，不由模型名推断。
context_window=128000
# 工作与摘要的实际输出上限；还需额外保留 13000 自动安全余量。
max_output_tokens=8192

# 可选：独立 Skill 在同一服务选择其他模型时，显式声明窗口和输出额度。
# 将 small-model 替换为服务实际支持的模型 ID；窗口必须大于输出 + 13000。
# skill_models='{"small-model":{"context_window":64000,"max_output_tokens":4096}}'

# 可选 Agent 别名、插件角色目录、后台精确工具名单；省略保持缺省。
# agent_models='{"haiku":{"model":"your-small-model","context_window":64000,"max_output_tokens":4096}}'
# agent_plugin_dirs='["/absolute/path/to/plugin/agents"]'
# agent_background_tools='["read_file","write_file","edit_file","execute_command","glob_files","search_code","load_skill"]'

# 可选团队配置：auto 启动前优先探测 tmux，不可用时公开原因再选协程。
# 选定后启动／运行失败不会降级。
team_backend=auto
team_max_running=4
team_max_queued=32
# 还要求真实启动环境 MEWCODE_COORDINATOR=1 和 Lead 身份。
# 在本文件写同名环境变量不能代替真实进程环境；默认关闭。
team_coordinator_enabled=false
